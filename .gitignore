# --- Almacenamiento temporal y archivos de audio locales ----------------------
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.aac

# --- Backend: Python y FastAPI ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Caché de herramientas Python / Linters / Tests
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Frontend: Node, React, TypeScript y Vite ---------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
build/
*.local

# Logs de gestores de paquetes (pnpm / npm / yarn)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caché de TypeScript y Vite
*.tsbuildinfo
.vite/

# --- Editores e IDEs (VS Code) ------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

